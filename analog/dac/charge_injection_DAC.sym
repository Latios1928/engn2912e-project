v {xschem version=3.4.8RC file_version=1.3}
K {type=subcircuit
format="@name @pinlist @symname"
template="name=x1"
}
T {@symname} -60 -100 0 0 0.3 0.3 {}
T {@name} -60 -120 0 0 0.2 0.2 {}
P 4 5 -100 -70 100 -70 100 70 -100 70 -100 -70 {}
B 5 -122.5 -52.5 -117.5 -47.5 {name=vref dir=in}
L 4 -120 -50 -100 -50 {}
T {vref} -95 -54 0 0 0.2 0.2 {}
B 5 -122.5 -32.5 -117.5 -27.5 {name=pre_b dir=in}
L 4 -120 -30 -100 -30 {}
T {pre_b} -95 -34 0 0 0.2 0.2 {}
B 5 -122.5 -12.5 -117.5 -7.5 {name=spike dir=in}
L 4 -120 -10 -100 -10 {}
T {spike} -95 -14 0 0 0.2 0.2 {}
B 5 -122.5 7.5 -117.5 12.5 {name=w0 dir=in}
L 4 -120 10 -100 10 {}
T {w0} -95 6 0 0 0.2 0.2 {}
B 5 -122.5 27.5 -117.5 32.5 {name=w1 dir=in}
L 4 -120 30 -100 30 {}
T {w1} -95 26 0 0 0.2 0.2 {}
B 5 -122.5 47.5 -117.5 52.5 {name=w2 dir=in}
L 4 -120 50 -100 50 {}
T {w2} -95 46 0 0 0.2 0.2 {}
B 5 117.5 -52.5 122.5 -47.5 {name=vdd dir=inout}
L 4 100 -50 120 -50 {}
T {vdd} 95 -54 0 1 0.2 0.2 {}
B 5 117.5 -32.5 122.5 -27.5 {name=vss dir=inout}
L 4 100 -30 120 -30 {}
T {vss} 95 -34 0 1 0.2 0.2 {}
B 5 117.5 -12.5 122.5 -7.5 {name=mem dir=inout}
L 4 100 -10 120 -10 {}
