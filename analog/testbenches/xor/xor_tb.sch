v {xschem version=3.4.8RC file_version=1.3}
G {}
K {}
V {}
S {}
F {}
E {}
T {xor_tb: the 2-2-1 snn_analog (pure ngspice, no Verilog), weights c0..c7 signed (-7..+7).
pulse[0] = A (ina), pulse[1] = B (inb): 10 us pulses every tsp from t0. Membranes start at 0 V.
run_xor.py counts the spikes of every neuron in the wrdata file. Generated by gen_xor_tb.py.
Default weights: XOR with hidden 0 = OR (+1 to the output) and hidden 1 = AND (+2 from each input, -7 to the output).} -900 -700 0 0 0.3 0.3 {}
C {snn_analog.sym} 300 -200 0 0 {name=x1}
C {lab_pin.sym} 150 -340 0 0 {name=l1 sig_type=std_logic lab=VDD}
C {lab_pin.sym} 150 -320 0 0 {name=l2 sig_type=std_logic lab=VSS}
C {lab_pin.sym} 150 -300 0 0 {name=l3 sig_type=std_logic lab=w[31:0]}
C {lab_pin.sym} 150 -280 0 0 {name=l4 sig_type=std_logic lab=pulse[1:0]}
C {lab_pin.sym} 150 -260 0 0 {name=l5 sig_type=std_logic lab=Vb}
C {lab_pin.sym} 150 -240 0 0 {name=l6 sig_type=std_logic lab=Vthr}
C {lab_pin.sym} 150 -220 0 0 {name=l7 sig_type=std_logic lab=VT_dpi}
C {lab_pin.sym} 150 -200 0 0 {name=l8 sig_type=std_logic lab=VNA}
C {lab_pin.sym} 150 -180 0 0 {name=l9 sig_type=std_logic lab=Vlk}
C {lab_pin.sym} 150 -160 0 0 {name=l10 sig_type=std_logic lab=VK}
C {lab_pin.sym} 150 -140 0 0 {name=l11 sig_type=std_logic lab=VIp}
C {lab_pin.sym} 150 -120 0 0 {name=l12 sig_type=std_logic lab=VKup}
C {lab_pin.sym} 150 -100 0 0 {name=l13 sig_type=std_logic lab=VKdn}
C {lab_pin.sym} 150 -80 0 0 {name=l14 sig_type=std_logic lab=Vamp_bias}
C {lab_pin.sym} 150 -60 0 0 {name=l15 sig_type=std_logic lab=VT}
C {lab_pin.sym} 150 -40 0 0 {name=l16 sig_type=std_logic lab=VT_inh}
C {lab_pin.sym} 150 -20 0 0 {name=l17 sig_type=std_logic lab=Vthr_in}
C {lab_pin.sym} 150 0 0 0 {name=l18 sig_type=std_logic lab=VT_in}
C {lab_pin.sym} 150 20 0 0 {name=l19 sig_type=std_logic lab=Vthr_hid}
C {lab_pin.sym} 150 40 0 0 {name=l20 sig_type=std_logic lab=VT_hid}
C {lab_pin.sym} 450 -200 0 1 {name=l21 sig_type=std_logic lab=spike[4:0]}
C {code_shown.sym} -900 -350 0 0 {name=MODELS only_toplevel=true
format="tcleval( @value )"
value="
.include $::180MCU_MODELS/design.ngspice
.lib $::180MCU_MODELS/sm141064.ngspice typical
.lib $::180MCU_MODELS/sm141064.ngspice mimcap_typical
"}
C {code_shown.sym} -900 -230 0 0 {name=TRAN_SIM only_toplevel=false
value=".param vdd=3.3 iref=14.42n
.param p_vthr=2.70 p_vtau=0.5096 p_vtau_i=0.5096
.param p_vthr_in=2.4 p_vtau_in=0.695 p_vthr_hid=2.5 p_vtau_hid=0.655
.param p_vlk=0.48 p_vamp_bias=0.535 p_vip=0.573 p_vna=1.93 p_vkup=2.35 p_vk=1.22 p_vkdn=0.588 p_vt=1.66
* Signed weights -7..+7, word k: 0, 1 pulse -> input; 2 + 2j + i input i -> hidden j; 6 + j hidden j -> output
.param c0=7 c1=7 c2=7 c3=7 c4=2 c5=2 c6=1 c7=-7
.param ina=1 inb=1 tpw=10u tsp=200u t0=100u tstop=4.1m
.csparam tstop_c=\{tstop\}
Vdd VDD 0 \{vdd\}
Vss VSS 0 0
* DAC unit current: Iref into a diode-connected unit current source (w[0] = 15 nA)
Iref VDD Vb \{iref\}
XMref Vb Vb 0 0 nfet_03v3 L=8u W=1u nf=1
* VT_* are source-gate voltages of the DPI tau pFET (VT = VDD - p_vtau)
Vthr Vthr 0 \{p_vthr\}
Vtau VDD VT_dpi \{p_vtau\}
Vtau_i VDD VT_inh \{p_vtau_i\}
Vthr_in Vthr_in 0 \{p_vthr_in\}
Vtau_in VDD VT_in \{p_vtau_in\}
Vthr_hid Vthr_hid 0 \{p_vthr_hid\}
Vtau_hid VDD VT_hid \{p_vtau_hid\}
VNA VNA VSS \{p_vna\}
Vlk Vlk VSS \{p_vlk\}
VK VK VSS \{p_vk\}
VIp VIp VSS \{p_vip\}
VKup VKup VSS \{p_vkup\}
VKdn VKdn VSS \{p_vkdn\}
Vamp_bias Vamp_bias VSS \{p_vamp_bias\}
VT VT VSS \{p_vt\}
Vw0 w[0] 0 \{vdd*(floor(abs(c0)/1)-2*floor(abs(c0)/2))\}
Vw1 w[1] 0 \{vdd*(floor(abs(c0)/2)-2*floor(abs(c0)/4))\}
Vw2 w[2] 0 \{vdd*(floor(abs(c0)/4)-2*floor(abs(c0)/8))\}
Vw3 w[3] 0 \{c0<0 ? vdd : 0\}
Vw4 w[4] 0 \{vdd*(floor(abs(c1)/1)-2*floor(abs(c1)/2))\}
Vw5 w[5] 0 \{vdd*(floor(abs(c1)/2)-2*floor(abs(c1)/4))\}
Vw6 w[6] 0 \{vdd*(floor(abs(c1)/4)-2*floor(abs(c1)/8))\}
Vw7 w[7] 0 \{c1<0 ? vdd : 0\}
Vw8 w[8] 0 \{vdd*(floor(abs(c2)/1)-2*floor(abs(c2)/2))\}
Vw9 w[9] 0 \{vdd*(floor(abs(c2)/2)-2*floor(abs(c2)/4))\}
Vw10 w[10] 0 \{vdd*(floor(abs(c2)/4)-2*floor(abs(c2)/8))\}
Vw11 w[11] 0 \{c2<0 ? vdd : 0\}
Vw12 w[12] 0 \{vdd*(floor(abs(c3)/1)-2*floor(abs(c3)/2))\}
Vw13 w[13] 0 \{vdd*(floor(abs(c3)/2)-2*floor(abs(c3)/4))\}
Vw14 w[14] 0 \{vdd*(floor(abs(c3)/4)-2*floor(abs(c3)/8))\}
Vw15 w[15] 0 \{c3<0 ? vdd : 0\}
Vw16 w[16] 0 \{vdd*(floor(abs(c4)/1)-2*floor(abs(c4)/2))\}
Vw17 w[17] 0 \{vdd*(floor(abs(c4)/2)-2*floor(abs(c4)/4))\}
Vw18 w[18] 0 \{vdd*(floor(abs(c4)/4)-2*floor(abs(c4)/8))\}
Vw19 w[19] 0 \{c4<0 ? vdd : 0\}
Vw20 w[20] 0 \{vdd*(floor(abs(c5)/1)-2*floor(abs(c5)/2))\}
Vw21 w[21] 0 \{vdd*(floor(abs(c5)/2)-2*floor(abs(c5)/4))\}
Vw22 w[22] 0 \{vdd*(floor(abs(c5)/4)-2*floor(abs(c5)/8))\}
Vw23 w[23] 0 \{c5<0 ? vdd : 0\}
Vw24 w[24] 0 \{vdd*(floor(abs(c6)/1)-2*floor(abs(c6)/2))\}
Vw25 w[25] 0 \{vdd*(floor(abs(c6)/2)-2*floor(abs(c6)/4))\}
Vw26 w[26] 0 \{vdd*(floor(abs(c6)/4)-2*floor(abs(c6)/8))\}
Vw27 w[27] 0 \{c6<0 ? vdd : 0\}
Vw28 w[28] 0 \{vdd*(floor(abs(c7)/1)-2*floor(abs(c7)/2))\}
Vw29 w[29] 0 \{vdd*(floor(abs(c7)/2)-2*floor(abs(c7)/4))\}
Vw30 w[30] 0 \{vdd*(floor(abs(c7)/4)-2*floor(abs(c7)/8))\}
Vw31 w[31] 0 \{c7<0 ? vdd : 0\}
Vp0 pulse[0] 0 pulse(0 \{vdd*ina\} \{t0\} 10n 10n \{tpw\} \{tsp\})
Vp1 pulse[1] 0 pulse(0 \{vdd*inb\} \{t0\} 10n 10n \{tpw\} \{tsp\})
* spike[n] copied to sp<n> (no load) for wrdata
Esp0 sp0 0 spike[0] 0 1
Esp1 sp1 0 spike[1] 0 1
Esp2 sp2 0 spike[2] 0 1
Esp3 sp3 0 spike[3] 0 1
Esp4 sp4 0 spike[4] 0 1
.ic v(x1.VMEM_0)=0 v(x1.VMEM_1)=0 v(x1.VMEM_2)=0 v(x1.VMEM_3)=0 v(x1.VMEM_4)=0 v(spike[0])=0 v(spike[1])=0 v(spike[2])=0 v(spike[3])=0 v(spike[4])=0
.options method=gear

.control
  save v(sp0) v(sp1) v(sp2) v(sp3) v(sp4) v(x1.VMEM_0) v(x1.VMEM_1) v(x1.VMEM_2) v(x1.VMEM_3) v(x1.VMEM_4)
  set wr_singlescale
  set wr_vecnames
  * Max step 0.1u: at 0.5u a relay spike edge sometimes kicked a neuron into a false spike
  tran 0.1u $&tstop_c 0 0.1u
  meas tran vmax_out max v(x1.VMEM_4)
  echo RES vmax_out=$&vmax_out
  wrdata xor_tb.txt v(sp0) v(sp1) v(sp2) v(sp3) v(sp4) v(x1.VMEM_0) v(x1.VMEM_1) v(x1.VMEM_2) v(x1.VMEM_3) v(x1.VMEM_4)
  if $?batchmode = 0
    plot v(x1.VMEM_4) v(sp4)+4 v(sp2)*0.3+8 v(sp3)*0.3+9.5 v(sp0)*0.3+11 v(sp1)*0.3+12.5 title 'Output membrane, output spike; hidden OR, AND; inputs A, B (offset)' ylabel 'V'
  end
.endc
"}
